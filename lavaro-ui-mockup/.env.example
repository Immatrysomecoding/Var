# Lavaro UI — Environment Variables
# Copy this to .env and adjust for your network

# FastAPI backend URL (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# MediaMTX host — the LAN IP of the machine running Docker
# Use the same value as MEDIA_HOST in the main .env
# (default: window.location.hostname, which works if UI is served from the same machine)
VITE_MEDIA_HOST=localhost
