# Copy this file to .env and edit as needed.
# docker-compose reads .env automatically.

# The hostname or IP that browsers use to reach this machine.
# Set to your LAN IP (e.g. 192.168.1.50) so phones can connect.
# Use "localhost" for local dev only.
MEDIA_HOST=localhost

# Venue and default field (must match values.yml deployment section)
VENUE_ID=playground-hcm-01
FIELD_ID=court-1

# Recording cleanup: delete segments older than this many hours
RECORDING_TTL_HOURS=2
